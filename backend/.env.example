# Backend Environment Template
# ------------------------------------------------
# Database (PostgreSQL Connection String)
CRM_DB_URL=postgresql://user:password@host:port/database

# Read-only Manager App DB (Optional/Secondary)
APP_DB_URL=postgresql://user:password@host:port/database

# Server
PORT=5000
NODE_ENV=development

# Allowed Frontend CORS Origin (Local / Production)
# Local: http://localhost:5173
# Production (Render): https://crm-maram-milk.vercel.app
FRONTEND_URL=http://localhost:5173

# Security
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=24h
