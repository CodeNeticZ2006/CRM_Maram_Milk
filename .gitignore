# Root-level .gitignore — Maram Milk CRM
# ─────────────────────────────────────────────────────────────────

# ── Generated Documentation & Local User Guides ──────────────────
MODULES_USER_GUIDE.md
WALKTHROUGH.md
IMPLEMENTATION_PLAN.md

# ── Temporary Utility & Scratch Scripts ───────────────────────────
backend/src/utils/update_admin.js
backend/src/utils/inspect_db2.js
backend/src/seeds/temp_*.js
backend/src/seeds/check_*.js
backend/src/seeds/verify_*.js
backend/test_*.js
scratch/
tmp/
temp/
*.tmp
*.scratch

# ── OS & Editor Artifacts ────────────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.bak

# ── Environment Files (NEVER commit secrets) ──────────────────────
.env
.env.*
!.env.example
*.env

# ── Node.js & Package Managers ────────────────────────────────────
node_modules/
**/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/

# ── Backend Build Output & Runtime Logs ───────────────────────────
backend/dist/
backend/build/
backend/*.log
backend/node_modules/

# ── Frontend Build Output & Cache ────────────────────────────────
frontend/dist/
frontend/build/
frontend/.vite/
frontend/node_modules/

# ── Logs & Debugging ─────────────────────────────────────────────
logs/
*.log

# ── TypeScript & Coverage ────────────────────────────────────────
*.tsbuildinfo
.cache/
coverage/

data-*.csv
