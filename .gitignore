# Root-level .gitignore — Maram Milk CRM
# ─────────────────────────────────────────────────────────────────

# ── Environment & Secret Files (NEVER commit credentials) ───────
.env
.env.*
!.env.example
*.env
env
**/env

# ── Node.js & Package Managers ────────────────────────────────────
node_modules/
**/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/

# ── Build Output & Caches ─────────────────────────────────────────
dist/
build/
**/dist/
**/build/
.vite/
**/.vite/
.cache/
coverage/
*.tsbuildinfo

# ── Temporary Utility, Diagnostic & Scratch Scripts ───────────────
backend/test_*.js
backend/check_*.js
backend/inspect_*.js
backend/src/utils/update_admin.js
backend/src/utils/inspect_db2.js
backend/src/seeds/temp_*.js
backend/src/seeds/check_*.js
backend/src/seeds/fix_*.js
backend/src/seeds/verify_*.js
backend/src/seeds/inspect_*.js
scratch/
tmp/
temp/
*.tmp
*.scratch

# ── OS & Editor Artifacts ────────────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.bak

# ── Logs & Debugging ─────────────────────────────────────────────
logs/
*.log

# ── Documentation & Local User Guides ────────────────────────────
MODULES_USER_GUIDE.md
WALKTHROUGH.md
IMPLEMENTATION_PLAN.md
PROJECT_CONTEXT.md
TASK_TRACKER.md
data-*.csv

